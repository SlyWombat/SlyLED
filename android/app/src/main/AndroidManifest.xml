<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- #804 — Auto Brightness (mic envelope follower) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- #820 — Audio Source = Playback Capture (loopback). Foreground
         service of type mediaProjection is mandatory on Android 14 (API 34)
         + before MediaProjection.createAudioRecord can be called. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- #888 — Haptics.kt vibrates on every Command-Surface action -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".SlyLedApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SlyLED"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SlyLED">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="slyled" />
            </intent-filter>
        </activity>

        <!-- #820 — Foreground service that holds MediaProjection alive
             while AudioPlaybackCaptureConfiguration is recording. Service
             type "mediaProjection" is required by Android 14+. The
             notification is shown for the duration of the capture so the
             operator always sees the system mic/projection indicator. -->
        <service
            android:name=".audio.PlaybackCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
