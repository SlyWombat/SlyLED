<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en_CA</string>
    <key>CFBundleDisplayName</key>
    <string>SlyLED</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>0.7.0</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>
    <key>NSLocalNetworkUsageDescription</key>
    <string>SlyLED talks to the orchestrator computer over your local Wi-Fi to control the lighting rig.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>SlyLED uses the microphone for Auto Brightness, which follows the music's loudness to drive the master light level. The mic is only active when Auto Brightness is enabled.</string>
    <key>NSCameraUsageDescription</key>
    <string>SlyLED uses the camera to scan the QR code shown on the orchestrator's Settings tab. Scanning fills in the server address automatically so you don't have to type it.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_slyled._tcp</string>
        <string>_http._tcp</string>
    </array>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <key>UILaunchScreen</key>
    <dict/>
    <!-- App Store validator requires CFBundleIconName when icons live in
         an Asset Catalog (the only way Apple accepts icons since iOS 11).
         Resolves the Asset Catalog's "AppIcon" set. -->
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <!-- Skip iPad multitasking. Without this, App Store validation
         requires all 4 orientations + a storyboard launch screen. The
         SlyLED operator app is portrait-only on iPhone; the iPad form
         factor isn't a v0.1 target. UIRequiresFullScreen=YES tells the
         OS the app runs full-screen on iPad too, bypassing the
         multitasking-app requirements. -->
    <key>UIRequiresFullScreen</key>
    <true/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict>
</plist>
